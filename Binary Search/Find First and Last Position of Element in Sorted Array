class Solution {
    public static int firstOccurance(int[] nums,int target){
        int start = 0;
        int end = nums.length-1;
        int ans = -1;
        while(start<=end){
            int mid = start + (end-start)/2;
            if(nums[mid]==target){
                ans = mid;
                end = mid-1;
            }
            else if(nums[mid]>target){
                end = mid-1;
            }
            else{
                start = mid+1;
            }
        }

        return ans;
    }

     public static int lastOccurance(int[] nums,int target){
        int start = 0;
        int end = nums.length-1;
        int ans = -1;
        while(start<=end){
            int mid = start + (end-start)/2;
            if(nums[mid]==target){
                ans = mid;
                start = mid+1;
            }
            else if(nums[mid]>target){
                end = mid-1;
            }
            else{
                start = mid+1;
            }
        }

        return ans;
    }
    public int[] searchRange(int[] nums, int target) {
        int final1 = firstOccurance(nums,target);
        int final2 = lastOccurance(nums,target);
        return new int[]{final1, final2};
    }
}
