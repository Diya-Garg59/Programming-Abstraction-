class Solution {
    public List<Integer> addToArrayForm(int[] num, int k) {
        List<Integer> ans = new ArrayList<>();
        int n = num.length;
        int carry = 0;
        int i = n-1;
        while(i>=0 || k>0 || carry>0){
            int digit = k%10;
            int numDigit;
            if(i>=0){
                numDigit = num[i];
            }
            else{
                numDigit = 0;
            }
            int sum = digit + numDigit + carry;
            carry = sum/10;
            int store = sum % 10;
            k = k/10;
            
            ans.add(0,store);

            i--;
        }



        return ans;
    }
}
