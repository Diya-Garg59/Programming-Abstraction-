class Main{
	static int findMax(int[] arr){
		int max = Integer.MIN_VALUE;
		for(int i=0; i<arr.length;i++){
			if(arr[i] > max){
				max = arr[i];
			}
		}
	
		return max;
	}
	
	public static void main(String[] args){
		int[] arr = {3,6,8,4,6};
		int ans = findMax(arr);
		System.out.println(ans);
	}
}
